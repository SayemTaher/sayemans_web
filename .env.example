# ── Site ────────────────────────────────────────────────
VITE_SITE_URL=https://sayemans.org

# ── Firebase (Project settings → General → Your apps → Web app) ──
# Leave empty to run the site with the local fallback adapter (no backend).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Firebase App Check (reCAPTCHA Enterprise site key) — optional ──
VITE_FIREBASE_APPCHECK_KEY=
